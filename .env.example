# Copy this file to .env, replace every change-me-* value, then run:
# ./scripts/check-config.sh --require-local
#
# Never commit .env or paste real credentials into this example file.

# Project and pipeline
CONFIG_VERSION=1
PIPELINE_TIMEZONE=Asia/Ho_Chi_Minh
PIPELINE_SCHEDULE_CRON="15 7 * * *"
PIPELINE_OVERLAP_DAYS=3
USGS_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_MIN_LATITUDE=20.0
USGS_MAX_LATITUDE=50.0
USGS_MIN_LONGITUDE=120.0
USGS_MAX_LONGITUDE=155.0
USGS_SEED_START_UTC=2023-01-01T00:00:00Z
USGS_MAX_WINDOW_DAYS=3
USGS_REQUEST_LIMIT=20000
USGS_HTTP_TIMEOUT_MS=30000
USGS_HTTP_MAX_ATTEMPTS=4
USGS_HTTP_INITIAL_BACKOFF_MS=250
USGS_HTTP_MAX_BACKOFF_MS=4000
USGS_MAX_RESPONSE_BYTES=10485760
USGS_EVENT_TYPE=earthquake
# Executable is included in the project Airflow image by USG-06.
USGS_INGEST_RUNNER_COMMAND=/opt/pipeline/bin/usgs-ingest-runner
USGS_INGEST_RUNNER_TIMEOUT_SECONDS=3600
USGS_INGEST_DRY_RUN=false

# JMA-04 manual backfill; no source calls until explicitly triggered with preview=false.
JMA_INGEST_RUNNER_COMMAND=/opt/pipeline/bin/jma-ingest-runner
JMA_INGEST_RUNNER_TIMEOUT_SECONDS=900
JMA_BACKFILL_MAX_CONCURRENCY=2
JMA_HTTP_TIMEOUT_MS=60000
JMA_MAX_ARCHIVE_BYTES=134217728
STRONG_MAGNITUDE_THRESHOLD=5.0

# Data lake paths shared by Spark, Iceberg and Trino
DATA_BUCKET=japan-earthquake
BRONZE_PREFIX=bronze
SILVER_PREFIX=silver
WAREHOUSE_PATH=s3://japan-earthquake/warehouse

# MinIO: S3 API stays internal; only Console is published to host.
# Use separate bootstrap/admin and pipeline credentials.
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ACCESS_KEY=change-me-pipeline-access-key
MINIO_SECRET_KEY=change-me-pipeline-secret-key
MINIO_CONSOLE_HOST_PORT=9001
S3_REGION=us-east-1

# Airflow and its metadata database
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin-password
AIRFLOW_FERNET_KEY=change-me-airflow-fernet-key
AIRFLOW_API_JWT_SECRET=change-me-airflow-api-jwt-secret
AIRFLOW_WEB_HOST_PORT=8080
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db-password
AIRFLOW_DB_NAME=airflow

# Spark runtime defaults for a local machine
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_HOST_PORT=8082
SPARK_WORKER_CORES=1
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g

# Iceberg REST Catalog
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_CATALOG_NAME=iceberg

# Trino serving endpoint
TRINO_HOST=trino
TRINO_INTERNAL_PORT=8080
TRINO_HOST_PORT=8081
TRINO_CATALOG=iceberg
TRINO_SCHEMA=earthquakes

# USG-01 owns the deterministic USGS request contract. The bounding box is the
# approved Japan study area; PIPELINE_OVERLAP_DAYS is the three-day revision
# window shared by daily and backfill plans.
